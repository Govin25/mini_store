<h1><%= @product.name %></h1>

<p>
  <strong>Price:</strong> ₹<%= @product.price %>
</p>

<p>
  <strong>Supplier:</strong> <%= @product.user&.name %>
</p>

<p>
  <strong>Subcategory:</strong> <%= @product.subcategory&.name %>
</p>

<p>
  <strong>Category:</strong> <%= @product.subcategory&.category&.name %>
</p>

<hr>

<%= link_to "Back", products_path %>

<!--  Customer: Add to cart -->
<% if current_user.customer? %>
  | <%= button_to "Add to Cart", cart_items_path(product_id: @product.id), method: :post %>
<% end %>

<!--  Supplier/Admin: Edit/Delete -->
<% if current_user.admin? || (current_user.supplier? && @product.user_id == current_user.id) %>
  | <%= link_to "Edit", edit_product_path(@product) %>
  | <%= button_to "Delete", @product, method: :delete, data: { turbo_confirm: "Are you sure?" } %>
<% end %>