<h2>All Products</h2>

<% if current_user.supplier?  %>
  <%= link_to "New Product", new_product_path %>
<% end %>

<% if @products.any? %>

<table border="1">

<tr>
<th>Name</th>
<th>Price</th>
<th>User</th>
<th>Subcategory</th>
<th>Category</th>

<% if current_user.customer? || current_user.supplier? %>
  <th>Actions</th>
<% end %>

</tr>

<% @products.each do |product| %>

<tr>
<td><%= product.name %></td>
<td><%= product.price %></td>
<td><%= product.user&.name %></td>
<td><%= product.subcategory&.name %></td>
<td><%= product.subcategory&.category&.name %></td>

<td>

  <% if current_user.customer? %>

    <!-- Add to Cart -->
    <%= button_to "Add to Cart",
        cart_items_path(product_id: product.id),
        method: :post %>

    <br>

    <!-- Wishlist Logic -->
    <% wishlist = current_user.wishlist %>
    <% item = wishlist&.wishlist_items&.find_by(product_id: product.id) %>

    <% if item %>
      <%= button_to "❌ Remove from Wishlist",
          wishlist_wishlist_item_path(item),
          method: :delete %>
    <% else %>
      <%= button_to "❤️ Add to Wishlist",
          wishlist_wishlist_items_path(product_id: product.id),
          method: :post %>
    <% end %>

  <% end %>

  <!-- ✅ Supplier/Admin: Edit/Delete -->
  <% if current_user.supplier? && product.user_id == current_user.id %>
    <br>
    <%= link_to "Edit", edit_product_path(product) %> |
    <%= link_to "Delete", product_path(product), method: :delete, data: { confirm: "Are you sure?" } %>
  <% end %>

</td>

</tr>

<% end %>

</table>

<% else %>

<p>No products found.</p>

<% end %>

<hr>

<h2>Your Cart</h2>

<% if current_user.customer? %>

  <% if @cart_items.present? %>

    <% @cart_items.each do |item| %>

      <p>
      Product: <%= item.product.name %> <br>
      Price: <%= item.product.price %> <br>
      Quantity: <%= item.quantity %>
      </p>

    <% end %>

  <% else %>

    <p>Cart is empty</p>

  <% end %>

<% end %>