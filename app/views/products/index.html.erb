<h2>All Products</h2>

<% if @products.any? %>

<table border="1">

<tr>
<th>Name</th>
<th>Price</th>
<th>User</th>
<th>Subcategory</th>
<th>Category</th>
<th>Cart</th>
</tr>

<% @products.each do |product| %>

<tr>
<td><%= product.name %></td>
<td><%= product.price %></td>
<td><%= product.user&.name %></td>
<td><%= product.subcategory&.name %></td>
<td><%= product.subcategory&.category&.name %></td>

<td>
<%= button_to "Add to Cart",
    cart_items_path(user_id: User.first.id, product_id: product.id),
    method: :post %>
</td>

</tr>

<% end %>

</table>

<% else %>

<p>No products found.</p>

<% end %>


<h2>Your Cart</h2>

<% if @cart_items.present? %>

  <% @cart_items.each do |item| %>

    <p>
    Product: <%= item.product.name %> <br>
    Price: <%= item.product.price %> <br>
    Quantity: <%= item.quantity %>
    </p>

  <% end %>

<% else %>

<p>Cart is empty</p>

<% end %>