<%= form_with model: @product do |form| %>

  <% if @product.errors.any? %>
    <div class="error">
      <% @product.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :price %>
    <%= form.number_field :price %>
  </div>

  <!--  REMOVE user dropdown completely -->

  <!--  Subcategory -->
  <div>
    <label>Select Subcategory</label>
    <%= select_tag :subcategory_id,
        options_from_collection_for_select(@subcategories, :id, :name, @selected_subcategory_id),
        prompt: "Choose Subcategory" %>
  </div>

  <div>
    <%= form.submit "Create Product" %>
  </div>

<% end %>