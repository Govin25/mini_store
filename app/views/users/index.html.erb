<h1>All Users</h1>

<%= link_to "Sign Up", new_user_registration_path %>

<table border="1">
  <tr>
    <th>Name</th>
    <th>Actions</th>
  </tr>

  <% @users.each do |user| %>
    <tr>
      <td><%= user.name %></td>

      <td>
        <%= link_to "Show", user_path(user) %>

        <% if current_user.supplier? || current_user.id == user.id %>
          | <%= link_to "Edit", edit_user_path(user) %>
        <% end %>

        <% if current_user.supplier? %>
          | <%= link_to "Delete", user_path(user), method: :delete, data: { confirm: "Are you sure?" } %>
        <% end %>

      </td>
    </tr>
  <% end %>
</table>