<%= form_with model: user do |form| %>

  <% if user.errors.any? %>
    <div style="color: red;">
      <h3><%= pluralize(user.errors.count, "error") %> prohibited this user from being saved:</h3>
      <ul>
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit %>
  </div>

<% end %>